{
  "name": "@ai3/ledger",
  "version": "0.14.0",
  "type": "module",
  "description": "AI3 Ledger \u2014 accounting for agent organisations. Paperclip plugin; platform-agnostic core.",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json && node scripts/build-ui.mjs && node scripts/gen-plugin-migration.mjs",
    "build:migrations": "node scripts/gen-plugin-migration.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.831.1",
    "@paperclipai/shared": "2026.831.1",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "main": "dist/core/index.js",
  "paperclipPlugin": {
    "manifest": "dist/manifest.js"
  },
  "files": [
    "dist",
    "plugin-migrations",
    "migrations",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "SEE LICENSE IN README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xTrinity3/ai3-ledger"
  },
  "homepage": "https://ai3.co/paperclip",
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "accounting",
    "ledger",
    "invoices",
    "agents"
  ]
}
